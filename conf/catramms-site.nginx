# Included by:
#   server {
#       server_name catramms.com;
#       listen 10.0.1.14:8094;
#       include /opt/mms/MMS/conf/catramms-site.nginx;
#   }
#
# TLS is terminated at the load balancer; nginx sees plain HTTP on port 8094.

root  /opt/mms/MMS/catramms-site;
index index.html;

# ── Real client IP (forwarded by the load balancer) ───────────────────────────
real_ip_header    X-Forwarded-For;
set_real_ip_from  10.0.1.0/24;   # adjust to the LB's subnet if needed

# ── Security headers ──────────────────────────────────────────────────────────
# HSTS is still meaningful: the browser connects to the LB over HTTPS
add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
add_header X-Frame-Options           "SAMEORIGIN"                          always;
add_header X-Content-Type-Options    "nosniff"                             always;
add_header Referrer-Policy           "strict-origin-when-cross-origin"     always;
add_header X-XSS-Protection          "1; mode=block"                       always;

# ── Compression ───────────────────────────────────────────────────────────────
gzip              on;
gzip_vary         on;
gzip_proxied      any;
gzip_comp_level   6;
gzip_min_length   1024;
gzip_types        text/html text/css text/plain
                  application/javascript application/json
                  image/svg+xml;

# ── Block sensitive files ─────────────────────────────────────────────────────
location ~* ^/(\.env|\.env\..+|config\.php|composer\.(json|lock)|\.gitignore|\.htaccess) {
    deny all;
    return 404;
}

location ^~ /vendor/ {
    deny all;
    return 404;
}

# ── PHP ───────────────────────────────────────────────────────────────────────
# Only send-mail.php is executed by PHP-FPM; every other .php returns 404.
location = /send-mail.php {
    fastcgi_pass unix:/run/php/php8.3-fpm.sock;   # adjust PHP version as needed
    include      fastcgi_params;
    fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;

    fastcgi_read_timeout 30s;
    fastcgi_send_timeout 30s;

    limit_except POST {
        deny all;
    }
}

location ~* \.php$ {
    deny all;
    return 404;
}

# ── Static asset caching ──────────────────────────────────────────────────────
location ~* \.(css|js|woff2?|ttf|otf|eot|svg|ico|png|jpe?g|gif|webp)$ {
    expires    1y;
    add_header Cache-Control "public, immutable";
    access_log off;
}

location ~* \.html$ {
    expires    1h;
    add_header Cache-Control "public, must-revalidate";
}

# ── Routing ───────────────────────────────────────────────────────────────────
location / {
    try_files $uri $uri/ =404;
}

# ── Logging ───────────────────────────────────────────────────────────────────
access_log /var/log/nginx/catramms.access.log;
error_log  /var/log/nginx/catramms.error.log;
